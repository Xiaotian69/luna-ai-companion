# Cloud text model. Create your own key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Optional cloud speech. Create your own key at https://platform.minimaxi.com/
MINIMAX_API_KEY=replace-with-your-minimax-key

# Single-user login password. Use at least 8 characters.
APP_PASSWORD=replace-with-a-strong-local-password

# Cookie signing secret. Generate at least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

ENVIRONMENT=development
